		<view class="set_item">
			<text>自动备份</text>
			<switch class="switch-checked" :checked="appConfig.backup" @change="backupSwitch" />
		</view>

		<view class="set_item">
			<text>释放空间</text>
			<switch class="switch-checked" :checked="appConfig.releaseSpace"
				@change="appConfig.releaseSpace = !appConfig.releaseSpace" />
		</view>
