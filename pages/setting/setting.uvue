	/**
	 * 修改设置是否备份
	 */
	function backupSwitch(e : UniSwitchChangeEvent) {
		appConfig.backup = e.detail.value
	}

	function navTo() {
		uni.navigateTo({
			url: "/pages/index/index?pattern=2"
		})
	}


	onUnload(() => {
		// 存储设置
		setAppConfig(appConfig)

		// 添加任务队列
		if (appConfig.backup) {

			// 确认备份，就在服务器上创建一个根目录




			tankTaskQueue.push({
				type: 1,
				status: 0
			} as taskQueueType)
		}
	})
