	.prv_cont {
		position: fixed;
		top: 0;
		bottom: 0;
		background-color: #000;

		.prv_sw {
			width: 100%;
			height: 100%;

			.prv_sit {
				display: flex;
				align-items: center;
				justify-content: center;

				.prv_img {
					width: 100%;
				}
			}
		}
	}



	.ab_it {
		margin-bottom: 10px;
		display: flex;
		flex-direction: row;
		align-items: center;

		.ab_v {
			// width: 100%;
			// height: 100%;
			position: relative;
