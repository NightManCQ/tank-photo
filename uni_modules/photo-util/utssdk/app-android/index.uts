	/**
	 * 获取所有相册
	 * 应该根据相册id分组查询
	 */
	static getAlbum() : Array<Album> {
		// //console.log("---------------进来了  ···111");
		// const { albums } = albumUtil
		const albums : Array<Album> = []
		const photoList : photoListType = hashMapOf()
		albumUtil.queryAlbumsPro(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, albums, photoList)
		albumUtil.queryAlbumsPro(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, albums, photoList)
		return albums
	}



	/**
	 * 分析出相册列表
	 */
	static queryAlbumsPro(uri : Uri, albums : Array<Album>, photoList : photoListType) {
		const cursor : Cursor = this.contentResolver.query(
			uri,
			albumsOption,//列
			"",//查询条件
			null,
			MediaStore.Files.FileColumns.DATE_ADDED + " DESC"
		) as Cursor
		let fileBucketId = cursor.getColumnIndexOrThrow(fileClumns.BUCKET_ID)
		let fileBucketDisplayName = cursor.getColumnIndexOrThrow(fileClumns.BUCKET_DISPLAY_NAME)
		let fileUrl = cursor.getColumnIndexOrThrow(fileClumns.DATA)
		while (cursor.moveToNext()) {
			let bucketId : number = cursor.getLong(fileBucketId)
			let bucketDisplayName : string = cursor.getString(fileBucketDisplayName)
			const url = cursor.getString(fileUrl)
			const item : Album | null = photoList[bucketDisplayName]
			if (item == null) {
				photoList[bucketDisplayName] = {
					id: bucketId,
					name: bucketDisplayName,
					coverPicture: url,
					count: 0,
					correlationId: hashMapOf()
				} as Album
				photoList[bucketDisplayName]!!.count = 1
				albums.push(photoList[bucketDisplayName]!);
			} else {
				item.count += 1
				item.correlationId[bucketId] = 1
			}
		}
	}






	/**
	 * 根据相册 id 获取里面的照片（包括gif）和视频
	 */
	static getAlbumsData(bucketId : Array<number>) : Array<MediaFile> {
		const uriList : Array<MediaFile> = []
		const { BUCKET_ID, DATE_ADDED, DATA, _ID, MIME_TYPE, TITLE } = fileClumns
		const strArr : string[] = []
		bucketId.forEach((val) => {
			strArr.push(`${BUCKET_ID} = '${val}'`)
		})

		let cursor : Cursor = this.contentResolver.query(
			externalContentUri,
			mediaFileOption,
			strArr.join(" or "),
			null,
			DATE_ADDED + " DESC"
		) as Cursor
		let fileUrl = cursor.getColumnIndexOrThrow(DATA)
		let fileId = cursor.getColumnIndexOrThrow(_ID)
		let mt = cursor.getColumnIndexOrThrow(MIME_TYPE)
		let tit = cursor.getColumnIndexOrThrow(TITLE)
		while (cursor.moveToNext()) {
			const url = cursor.getString(fileUrl)
			// console.log("url", url);
			const fileObj : MediaFile = {
				id: cursor.getInt(fileId),
				title: cursor.getString(tit),
				url,
				ty: cursor.getString(mt),
				uri: Uri.parse(url),
				type: 1
			} as MediaFile
			uriList.push(fileObj)
		}
		return uriList
	}
}